# jobfinder environment. Copy to .env for development; in production these live in
# /etc/jobfinder/jobfinder.env (mode 600). Empty values count as unset.

# --- AI (required) -----------------------------------------------------------
# groq (development) or deepseek (production)
AI_PROVIDER=groq
# Key for the active provider is required; the other may stay empty.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Optional model overrides; must be listed under the provider in providers.yaml.
# Defaults: groq -> openai/gpt-oss-120b, deepseek -> deepseek-v4-pro
AI_MODEL_SCORE=
AI_MODEL_PROFILE=

# --- Identity (required) -----------------------------------------------------
# Sent in the User-Agent so API operators can reach you.
CONTACT_EMAIL=you@example.com

# --- Paths and storage -------------------------------------------------------
# Data directory (workbook, state.db, profiles, CV). Default /var/lib/jobfinder.
DATA_DIR=./var
# Directory holding settings.yaml, sources.yaml, providers.yaml. Default ./config.
JOBFINDER_CONFIG_DIR=./config
# excel (default) or sqlite
STORAGE_BACKEND=excel

# --- Sources (required only when the source is enabled in sources.yaml) -------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# --- Notifications (optional; set both Telegram values or neither) ------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Pinged after each successful run (e.g. healthchecks.io).
HEALTHCHECK_URL=
