# Installed by deploy/install.sh. Runs one jobfinder pass; started by jobfinder.timer.
[Unit]
Description=jobfinder: fetch, score and store job opportunities
Documentation=file:///opt/jobfinder/current/README.md
Wants=network-online.target
After=network-online.target
OnFailure=jobfinder-alert.service

[Service]
Type=oneshot
User=jobfinder
Group=jobfinder
EnvironmentFile=/etc/jobfinder/jobfinder.env
WorkingDirectory=/var/lib/jobfinder
# Concurrency: `jobfinder run` itself takes an exclusive flock(2) on
# /var/lib/jobfinder/run.lock and exits 0 with "skipped" when it is held, which also
# covers manual runs. Wrapping it in flock(1) on the same file would make every run skip
# (the app's own lock attempt would conflict with the wrapper's), so it is not used.
ExecStart=/opt/jobfinder/current/.venv/bin/jobfinder run
# A oneshot's whole run is its start-up: RuntimeMaxSec= does not apply to
# Type=oneshot (systemd.service(5)), TimeoutStartSec= is what limits it.
TimeoutStartSec=15min
MemoryMax=512M
TimeoutStopSec=30s
Nice=5

# Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/jobfinder
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
