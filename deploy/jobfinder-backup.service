# Installed by deploy/install.sh. Daily backup of jobfinder's data; see backup.sh.
[Unit]
Description=jobfinder: daily backup
OnFailure=jobfinder-alert.service

[Service]
Type=oneshot
User=jobfinder
Group=jobfinder
EnvironmentFile=/etc/jobfinder/jobfinder.env
Environment=BACKUP_DIR=/var/backups/jobfinder BACKUP_KEEP=14
ExecStart=/opt/jobfinder/current/deploy/backup.sh
# A oneshot's whole run is its start-up: RuntimeMaxSec= does not apply to
# Type=oneshot (systemd.service(5)), TimeoutStartSec= is what limits it.
TimeoutStartSec=15min
MemoryMax=256M
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/jobfinder /var/backups/jobfinder
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
